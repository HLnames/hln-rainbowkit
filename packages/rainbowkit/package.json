{
  "name": "@hlnames/rainbowkit",
  "version": "2.0.0",
  "description": "The best way to connect a wallet - Now with Hyperliquid Names support!",
  "files": [
    "dist",
    "styles.css",
    "wallets",
    "components"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/index.css",
    "./wallets": "./dist/wallets/walletConnectors/index.js",
    "./components": "./dist/components/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "src/css/reset.css.ts"
  ],
  "engines": {
    "node": ">=12.4"
  },
  "scripts": {
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "dev": "pnpm build:watch & pnpm typegen:watch",
    "prepare": "MINIFY_CSS=true pnpm build",
    "prebuild": "pnpm typegen",
    "typecheck": "pnpm tsc --noEmit",
    "typegen": "tsc --emitDeclarationOnly -p tsconfig.types.json",
    "typegen:watch": "tsc --emitDeclarationOnly -p tsconfig.types.json --watch"
  },
  "keywords": [
    "ens",
    "ethereum",
    "react",
    "react-hook",
    "hooks",
    "blockchain"
  ],
  "author": "Rainbow",
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18",
    "react-dom": ">=18",
